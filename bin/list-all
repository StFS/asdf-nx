#!/usr/bin/env bash
set -euo pipefail

plugin_dir="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/utils.bash
source "$plugin_dir/lib/utils.bash"

list_all_versions() {
    local registry url
    registry="$(get_registry)"
    url="$registry/$TOOL_NAME"

    # Match only top-level version keys (followed by `:{`), not dependency-version
    # values which are quoted strings without the `:{` suffix.
    curl -sfL -H 'Accept: application/vnd.npm.install-v1+json' "$url" |
        grep -Eo '"[0-9]+\.[0-9]+\.[0-9]+[^"]*":\{' |
        sed 's/^"//; s/":{$//' |
        sort -u
}

list_all_versions |
    filter_unstable |
    sort_versions |
    tr '\n' ' '
echo
