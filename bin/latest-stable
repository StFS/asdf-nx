#!/usr/bin/env bash
set -euo pipefail

plugin_dir="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/utils.bash
source "$plugin_dir/lib/utils.bash"

registry="$(get_registry)"

curl -sfL "$registry/$TOOL_NAME" \
    | grep -Eo '"latest":"[^"]+"' \
    | head -n1 \
    | sed 's/.*"latest":"\([^"]*\)"/\1/'
